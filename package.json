{
  "name": "badinage",
  "version": "0.0.0",
  "description": "Self-hostable web XMPP client",
  "license": "0BSD",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "i18n": "typesafe-i18n --no-watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:omemo": "pnpm -F @quad4-software/omemo test",
    "icons": "node scripts/generate-icons.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@quad4-software/omemo": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@lucide/svelte": "1.41.0",
    "bits-ui": "2.19.0",
    "clsx": "2.1.1",
    "mode-watcher": "1.1.0",
    "paneforge": "1.0.2",
    "runed": "0.37.1",
    "strophe.js": "5.0.0",
    "svelte-sonner": "1.2.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "eslint": "10.10.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typesafe-i18n": "5.27.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0"
  }
}
